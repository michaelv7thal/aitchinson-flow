+            b, Lq, _ = h.shape
+            z = ((h.reshape(-1, d) - mu.to(h.device)) / sigma.to(h.device)).cpu()
+            w = torch.linalg.solve_triangular(L, z.double().T, upper=False)
+            out.append((w * w).sum(0).reshape(b, Lq).float())
+        return torch.cat(out)
+
+    return score
